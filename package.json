{
  "name": "ologle",
  "private": true,
  "version": "1.0.0",
  "description": "OLOGLE — Anonymous Peer-to-Peer Real-Time Video, Audio & Text Chat",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "node -e \"require('esbuild').buildSync({entryPoints:['server/index.ts'],bundle:true,platform:'node',format:'cjs',packages:'external',sourcemap:true,outfile:'dist/server.cjs'})\"",
    "preview": "vite preview",
    "start": "node dist/server.cjs",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});try{fs.unlinkSync('server.js')}catch(e){}\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^2.1.9"
  }
}
