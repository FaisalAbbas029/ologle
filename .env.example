# ============================================================
# OLOGLE — Environment Variable Reference
# ============================================================
# Copy this file to .env and fill in real values for local dev.
# NEVER commit .env to git.

# ------------------------------------
# SERVER-SIDE (Render.com / Node.js)
# ------------------------------------

# Gemini AI API key — required for icebreakers, transcription, translation.
GEMINI_API_KEY="your-gemini-api-key-here"

# Comma-separated list of additional allowed CORS origins.
# ologle.network, *.vercel.app, and *.onrender.com are always allowed.
# Example: ALLOWED_ORIGINS=https://ologle.network,https://www.ologle.network,https://your-custom-domain.com
ALLOWED_ORIGINS=""

# TURN server URLs (comma-separated) — required for NAT traversal on mobile/firewalls.
# Example using Metered.ca free tier:
#   TURN_URLS=turn:a.relay.metered.ca:80,turn:a.relay.metered.ca:443,turns:a.relay.metered.ca:443
TURN_URLS=""

# TURN shared secret — used to generate short-lived HMAC credentials server-side.
# Never expose this in frontend code.
TURN_SHARED_SECRET=""

# How long (in seconds) TURN credentials stay valid. Default: 600 (10 min).
TURN_CREDENTIAL_TTL_SECONDS=600

# ------------------------------------
# CLIENT-SIDE (Vite / Vercel frontend build)
# ------------------------------------

# Full WebSocket URL of your deployed Node.js signaling backend.
# Set this in Vercel -> Project Settings -> Environment Variables.
# The path must be /ws to match the backend WebSocket server path.
# Example: VITE_WEBSOCKET_URL="wss://YOUR-ACTUAL-BACKEND-DOMAIN/ws"
VITE_WEBSOCKET_URL=""

# Optional: Base HTTP URL for backend API calls if different from WebSocket origin.
# Example: VITE_API_URL="https://YOUR-ACTUAL-BACKEND-DOMAIN"
VITE_API_URL=""
